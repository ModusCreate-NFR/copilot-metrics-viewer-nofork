{
    "servers": {
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/"
        },
        "jira": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "mcp-atlassian"
            ],
            "envFile": "${workspaceFolder}/.demo/jira.env"
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp"
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ]
        }
    }
}
